run-command dnf install epel-release -y

# Install GNOME desktop from the Rocky AppStream group.
run-command dnf -y --setopt=install_weak_deps=False --setopt=tsflags=nodocs group install "GNOME" --exclude=*-firmware --exclude=linux-firmware

run-command dnf -y --setopt=install_weak_deps=False --setopt=tsflags=nodocs install firefox xrdp xorgxrdp net-tools vim nmap
run-command systemctl enable xrdp
run-command systemctl set-default graphical.target

# Set GNOME as the default desktop/session selection.
run-command sh -c 'printf "DESKTOP=GNOME\nDISPLAYMANAGER=GNOME\n" > /etc/sysconfig/desktop'

run-command mkdir -p /etc/firefox/policies
upload firefox-policies.json:/etc/firefox/policies/policies.json
run-command chown root:root /etc/firefox/policies/policies.json
run-command chmod 0644 /etc/firefox/policies/policies.json

run-command mkdir -p /etc/firewalld/zones
upload xrdp.xml:/etc/firewalld/zones/xrdp.xml
upload xrdp.ini:/etc/xrdp/xrdp.ini
run-command chown root:root /etc/firewalld/zones/xrdp.xml /etc/xrdp/xrdp.ini
run-command chmod 0644 /etc/firewalld/zones/xrdp.xml /etc/xrdp/xrdp.ini

# Keep full locale coverage so the image supports all languages.
run-command dnf -y install glibc-all-langpacks

# Cleanup
run-command dnf autoremove -y
run-command dnf clean all
run-command rm -rf /var/cache/dnf/* /var/tmp/* /tmp/*
run-command rm -rf /usr/share/doc/* /usr/share/man/* /usr/share/info/*
run-command journalctl --vacuum-time=1s || true

# Zero fill free space so qcow2 compaction reclaims it
run-command dd if=/dev/zero of=/var/tmp/zeros bs=1M || true
run-command rm -f /var/tmp/zeros

# Let the first real boot repair file labels without SELinux exec denials.
run-command sed -i 's/^SELINUX=.*/SELINUX=permissive/' /etc/selinux/config
run-command touch /.autorelabel

# Truncate machine-id
run-command truncate -s 0 /etc/machine-id
run-command truncate -s 0 /var/lib/dbus/machine-id
